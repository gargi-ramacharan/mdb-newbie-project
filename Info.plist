<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Supabase project. Leave both blank to run without a server (everything stays on the phone).
	     The anon key is meant to ship in the app; row-level security is what protects the data. -->
	<key>SupabaseURL</key>
	<string></string>
	<key>SupabaseAnonKey</key>
	<string></string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.relive.app.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>relive</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
